{
  "name": "@auctionoton/server",
  "version": "1.2.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./build --target bun",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run src/db/migrate.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "bun run build/index.js"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.0.2",
    "@elysiajs/swagger": "^0.8.5",
    "@sindresorhus/slugify": "^2.2.1",
    "buffer-polyfill": "^6.0.3",
    "dayjs": "^1.11.11",
    "drizzle-orm": "^0.30.10",
    "drizzle-zod": "^0.5.1",
    "elysia": "^1.0.22",
    "p-map": "^7.0.2",
    "postgres": "^3.4.4",
    "redis": "^4.6.14",
    "remeda": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.21.4",
    "@auctionoton/typescript-config": "workspace:*",
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  }
}
