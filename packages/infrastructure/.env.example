# Copy to .env.local. Runtime credentials are never placed in VITE_* values.
CLOUDFLARE_ACCOUNT_ID=
# Required in Workers Builds. Local runs can reuse an unexpired Wrangler login.
CLOUDFLARE_API_TOKEN=
# Generate two independent random secrets, each at least 32 characters.
CF_TRIAL_ADMIN_TOKEN=
CF_TRIAL_AUTH_SECRET=
# Wild Growth EU, Alliance. The trial imports only this house.
CF_TRIAL_HOUSE_ID=509

# TSM credentials used by the Worker and import workflows.
TSM_CLIENT_ID=
TSM_API_KEY=
TSM_API_KEY_B=
TSM_API_KEY_C=
TSM_API_KEY_D=

# Access resources belong to the sibling cloudflare-infra Terraform repository.
# Use the staging audience from its auctionoton_access_audiences output.
CLOUDFLARE_ACCESS_ISSUER=https://sandervspl.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=
# Staging Google audience from auctionoton_access_google_audiences.
CLOUDFLARE_ACCESS_GOOGLE_AUD=
# Optional reviewed mapping from verified issuer#subject to existing owner ID.
CLOUDFLARE_ACCESS_USER_ID_MAP={}

# Blizzard item/media catalog import credentials.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
