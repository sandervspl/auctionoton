{
  "name": "@auctionoton/extension",
  "version": "5.3.0",
  "description": "Display current Auction House price data for items on wowhead.com",
  "private": true,
  "main": "index.js",
  "author": "Sander Vispoel <sandervspl@github>",
  "license": "ISC",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "wxt:prepare": "wxt prepare",
    "tc": "pnpm run generate && pnpm run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate": "wxt prepare",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:dev": "node --experimental-strip-types --test tests/dev-server.test.mjs",
    "test:browser": "node --test tests/rendering.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tanstack/react-query": "^5.51.21",
    "@tanstack/react-query-devtools": "^5.51.21",
    "axios": "^1.7.3",
    "axios-rate-limit": "^1.4.0",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.12",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.424.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.52.2",
    "slugify": "^1.6.6",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsafe": "^1.7.2",
    "typed-query-selector": "^2.11.3",
    "valtio": "^1.13.2",
    "w3c-keys": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.269",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20.14.14",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@wxt-dev/module-react": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.15.18",
    "fs-extra": "^11.2.0",
    "node-notifier": "^10.0.1",
    "postcss-import": "^15.1.0",
    "tailwindcss": "^3.4.7",
    "typescript": "catalog:",
    "vite-plugin-banner": "^0.7.1",
    "wxt": "^0.19.4",
    "@auctionoton/typescript-config": "workspace:*",
    "@biomejs/biome": "catalog:",
    "vite": "6.4.3"
  }
}
