{
  "name": "@auctionoton/website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3001",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate": "tsr generate",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/access.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-postgres.mjs"
  },
  "dependencies": {
    "@auctionoton/search": "workspace:*",
    "@ark-ui/react": "^5.40.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.18",
    "lucide-react": "^1.82.0",
    "ofetch": "^1.5.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "use-debounce": "^10.1.1",
    "use-local-storage-state": "^20.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@auctionoton/typescript-config": "workspace:*",
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "5.20261127.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/router-cli": "1.168.0",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261123.1-beta",
    "nitro": "3.0.261103-rc",
    "seroval": "1.8.2",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite": "^8.4.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
