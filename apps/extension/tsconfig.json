{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "target": "es2020",
    "jsx": "react",
    "removeComments": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["esnext", "DOM"]
  },
  "exclude": ["node_modules"]
}
