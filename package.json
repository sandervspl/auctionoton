{
  "name": "auctionoton",
  "version": "0.0.0",
  "private": true,
  "license": "ISC",
  "scripts": {
    "dev": "turbo run dev",
    "dev:extension": "turbo run dev --filter=@auctionoton/extension",
    "dev:website": "turbo run dev --filter=@auctionoton/website",
    "dev:server": "turbo run dev --filter=@auctionoton/server",
    "build": "turbo run build",
    "build:firefox": "turbo run build:firefox --filter=@auctionoton/extension",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck",
    "test:cloudflare": "turbo run test --filter=@auctionoton/cloudflare",
    "cf:plan": "turbo run cf:plan --filter=@auctionoton/infrastructure",
    "cf:deploy": "turbo run cf:deploy --filter=@auctionoton/infrastructure",
    "cf:dev": "turbo run cf:dev --filter=@auctionoton/infrastructure",
    "zip": "turbo run zip --filter=@auctionoton/extension",
    "zip:firefox": "turbo run zip:firefox --filter=@auctionoton/extension",
    "db:migrate": "turbo run db:migrate --filter=@auctionoton/server",
    "cs:add": "changeset",
    "cs:ver": "changeset version",
    "e:version": "turbo run zip zip:firefox --filter=@auctionoton/extension"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.27.1",
    "turbo": "2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=22",
    "pnpm": "10.7.1"
  },
  "pnpm": {
    "overrides": {
      "@wxt-dev/module-react>@vitejs/plugin-react": "4.7.0",
      "effect": "4.0.0-rc.112",
      "@effect/platform-node-shared": "4.0.0-rc.112",
      "@effect/sql-d1": "4.0.0-rc.112",
      "@effect/sql-sqlite-do": "4.0.0-rc.112",
      "@effect/vitest": "4.0.0-rc.112"
    }
  }
}
